# Copy to .env and set strong values before any shared/production deploy.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
POSTGRES_USER=finance
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=finance
DATABASE_URL=postgresql+psycopg://finance:replace-with-strong-db-password@localhost:5432/finance
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Leave empty for Vite dev proxy; set for Docker/production frontend builds.
VITE_API_BASE=
